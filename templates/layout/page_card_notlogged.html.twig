{% set theme = current_theme() %}
{% if css_files is not defined %}
   {% set css_files = [
       {'path': 'lib/base.css'},
       {'path': 'lib/tabler.css'},
       {'path': 'css/glpi.scss'},
       {'path': 'css/core_palettes.scss'},

       {'path': 'css/siet-custom.css'}
   ] %}
   {% for theme_path in get_custom_themes_paths() %}
      {% set css_files = css_files|merge([{'path': theme_path}]) %}
   {% endfor %}
   {# TODO : load hight contrast css #}
{% endif %}
{% if js_files is not defined %}
   {% set js_files = [
       {'path': 'lib/base.js'},
       {'path': 'js/common.js'},
       {'path': 'lib/fuzzy.js'}
   ] %}
{% endif %}
{% if js_modules is not defined %}
   {% set js_modules = [] %}
{% endif %}
{% if custom_header_tags is not defined %}
   {% set custom_header_tags = [] %}

{% endif %}
{# JS scripts / modules are loaded in the header in anonymous pages #}
{% set js_files = js_files|merge(get_plugins_js_scripts_files(true)) %}
{% set js_modules = js_modules|merge(get_plugins_js_modules_files(true)) %}
{% set is_anonymous_page = true %}

{# Inject CSS directly into custom header tags to hide GLPI's injected footers #}
{% set custom_header_tags = custom_header_tags|merge([
   '<style>
      /* Hide GLPI copyright text elements globally on login page */
      .text-center.text-muted, 
      footer, 
      .glpi-footer, 
      [class*="footer"] { 
         display: none !important; 
      }
   </style>'
]) %}


{{ include('layout/parts/head.html.twig') }}
<body class="welcome-anonymous">
   <div class="skip-links">
      <a class="visually-hidden-focusable skip-link" href="#page">{{ __('Go to main content') }}</a>
   </div>
   <main id="page" class="page-anonymous" role="main" tabindex="-1">
      <div class="siet-auth-wrapper">
         <div class="siet-auth-left">
            <h1>Welcome to SIET-Helpdesk</h1>
            <p>The <strong>Sri Shakthi Institute of Engineering and Technology Helpdesk</strong> is your dedicated platform for reporting and tracking IT issues across campus.</p>
            <p><strong>SIET-Helpdesk provides</strong></p>
            <ul>
               <li>Quick issue reporting by category and location</li>
               <li>Real-time status tracking on every ticket you raise</li>
               <li>Fast technician assignment and resolution</li>
               <li>A simple, no-hassle way to keep campus IT running</li>
            </ul>
         </div>
         <div class="siet-auth-right">

            <div class="flex-fill d-flex flex-column justify-content-center py-4 mt-4">
               {% set style = null %}
               {% if card_md_width is defined %}
                  {% set style = 'max-width: 40rem' %}
               {% endif %}
               {% if card_bg_width is defined %}
                  {% set style = 'max-width: 60rem' %}
               {% endif %}
               <div class="container-tight py-6" {% if style is not null %}style="{{ style }}"{% endif %}>
                  <div class="text-center">
                     <div class="col-md">
                        <img src="/theme-assets/siet-logo.jpg" class="siet-logo" title="SIET-Helpdesk" alt="SIET logo"/>
                     </div>
                  </div>
                  <div class="card card-md main-content-card">
                     {# Keep the header on one line so that the :empty CSS selector will work #}
                     <div class="card-header">{% block header_block %}{% endblock %}</div>
                     <div class="card-body">
                        {% block content_block %}{% endblock %}

                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </main>
   {% block javascript_block %}{% endblock %}
</body>
</html>


